/* LogoLight 的简体中文界面。英文原文是键：找不到的键会原样显示英文，所以漏译只会退回英文。 */

/* 菜单 */
"Disable Password" = "禁用密码";
"Turn the logo on and off without entering your password. Uncheck to ask for it again." = "开关标志时无需输入密码。取消勾选则每次都要求输入密码。";
"Lit with Lid Closed" = "合盖仍点亮";
"On power or a display" = "接电源或有外接显示器时";
"Keep the logo lit when you close the lid, on power or with an external display. On power, your Mac stays awake with the lid closed. The keyboard stays dark." = "合上盖子后标志保持点亮（接电源或接有外接显示器时）。接电源时，Mac 在合盖状态下保持唤醒；键盘保持熄灭。";
"Language" = "语言";
"Follow the system" = "跟随系统";
"Launch at Login" = "登录时启动";
"Quit LogoLight" = "退出 LogoLight";
"LogoLight" = "LogoLight";
"Option-click to toggle" = "Option 点击可切换";
"LogoLight couldn't make the change" = "LogoLight 无法完成更改";
"LogoLight can't follow the sound" = "LogoLight 无法跟随声音";
"LogoLight can't hear the sound" = "LogoLight 无法听到声音";
"To let the logo follow the sound your Mac plays, allow LogoLight under System Audio Recording Only in System Settings › Privacy & Security › Screen & System Audio Recording, then turn Sound on again. Nothing is recorded." = "要让标志跟随 Mac 播放的声音，请在「系统设置 › 隐私与安全性 › 屏幕与系统音频录制」中，于「仅系统音频录制」类别下允许 LogoLight，然后重新打开「声音」。不会录制任何内容。";
"Open System Settings" = "打开系统设置";
"Cancel" = "取消";
"Couldn't change Launch at Login" = "无法更改「登录时启动」";

