"Off" = "关";
"Letters, digits and punctuation" = "字母、数字与标点";
"Stop" = "停止";
"Playing" = "播放中";
"Apple logo backlight" = "Apple 标志背光";
"Live view of the Apple logo" = "Apple 标志实时预览";

